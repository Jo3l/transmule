# ─── TransMule — Environment Variables ────────────────────────────────────────
# You normally never edit this file by hand: the installer generates it with
# real secrets and free ports (no git clone needed):
#   sh -c "$(curl -fsSL https://raw.githubusercontent.com/Jo3l/transmule/main/install.sh)"
#
# Doing it manually? Two files are enough — download them into the same folder
# and rename this one to ".env":
#   curl -fsSLO https://raw.githubusercontent.com/Jo3l/transmule/main/docker-compose.yml
#   curl -fsSLo .env https://raw.githubusercontent.com/Jo3l/transmule/main/.env.example

# ── User / group IDs (match your host user to avoid permission issues) ───────
PUID=1000
PGID=1000
TZ=Europe/Madrid

# ── Optional image overrides (useful for ARM64 tuning/fallbacks) ─────────────
# Defaults are multi-arch images. On ARM64, Docker will normally pull ARM64
# variants automatically. Only change these if you need to pin a specific tag.
TRANSMULE_APP_IMAGE=ghcr.io/jo3l/transmule:latest
AMULE_IMAGE=ngosang/amule:latest
TRANSMISSION_IMAGE=lscr.io/linuxserver/transmission:latest
PYLOAD_IMAGE=lscr.io/linuxserver/pyload-ng:latest
SLSKD_IMAGE=slskd/slskd:latest

# ── Download directories (host paths mounted into containers) ────────────────
DOWNLOAD_DIR=./downloads
INCOMPLETE_DIR=./incomplete

# ── Web UI ────────────────────────────────────────────────────────────────────
# Host port for the TransMule web interface (install.sh picks a free one).
TRANSMULE_PORT=3001

# ── aMule ─────────────────────────────────────────────────────────────────────
# Password for aMule's EC (External Connector) interface — used by the
# middleware to talk to amuled over its binary protocol on port 4712.
AMULE_GUI_PASSWORD=hLETKciXJlnMAN0Z

# Host ports for aMule P2P traffic (change if defaults conflict).
# Kad shares the UDP port with eD2K, so there is no separate Kad mapping.
AMULE_ED2K_TCP_PORT=4662
AMULE_ED2K_UDP_PORT=4672

# ── Transmission ──────────────────────────────────────────────────────────────
# Leave blank for no auth on the Transmission RPC endpoint.
TRANSMISSION_USER=
TRANSMISSION_PASS=

# Host port for Transmission peer traffic (change if default conflicts)
TRANSMISSION_PEER_PORT=51413

# ── Middleware ────────────────────────────────────────────────────────────────
# Host directory for the middleware SQLite database (users, config).
# Bind-mounted so data survives container rebuilds and volume prunes.
DATA_DIR=./data

# Secret for signing JWT tokens. The installer fills this with a random value;
# leave it empty to have the app generate one on first start and keep it in
# DATA_DIR/.jwt_secret (never share a placeholder between installs).
JWT_SECRET=

# ── pyLoad ───────────────────────────────────────────────────────────────────
# Credentials for pyLoad NG's web interface (used by the middleware to
# authenticate against pyLoad's HTTP API on port 8000).
# Default credentials set by linuxserver/pyload-ng are pyload / pyload.
# Change them via the pyLoad web UI and update these values to match.
PYLOAD_USER=pyload
PYLOAD_PASSWORD=pyload

# ── slskd ────────────────────────────────────────────────────────────────────
# Port for slskd Soulseek P2P traffic (change if default 50300 conflicts)
SLSKD_P2P_PORT=50300

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the middleware API.
# If the Docker host is accessed at http://myserver:3000, keep the default.
# Behind a reverse proxy with a sub-path, set e.g. https://myserver/api
API_BASE_URL=http://localhost:3000
